<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="상세 페이지"
                android:textStyle="bold"
                android:textSize="25sp"
                android:textAlignment="center"
                android:layout_marginVertical="10dp"
                android:layout_gravity="center"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/restroomName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="건물명"
                    android:textSize="25sp"
                    android:textStyle="bold"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <CheckBox
                    android:id="@+id/restroom_bookmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|right"
                    android:button="@drawable/bookmark" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <View
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="@color/black"
                    android:layout_marginRight="5dp"
                    android:layout_marginLeft="5dp" />
                <TextView
                    android:id="@+id/location"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="상세주소"
                    android:textSize="15sp"
                    android:breakStrategy="simple"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="개방시간"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginRight="10dp" />

                <TextView
                    android:id="@+id/openTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="개방시간"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- 편의시설 섹션 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="편의시설"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/facilityChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="false"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFullTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24시간 개방"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipStrokeColor="@color/gray"
                    app:chipStrokeWidth="1dp"
                    android:enabled="false"
                    app:textEndPadding="12dp"
                    app:textStartPadding="12dp"
                    android:textColor="@color/chip_text_selector"
                    style="@style/Widget.MaterialComponents.Chip.Filter"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDiaper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기저귀 교환대"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipStrokeColor="@color/gray"
                    app:chipStrokeWidth="1dp"
                    android:enabled="false"
                    app:textEndPadding="12dp"
                    app:textStartPadding="12dp"
                    android:textColor="@color/chip_text_selector"
                    style="@style/Widget.MaterialComponents.Chip.Filter"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAccessible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="장애인 화장실"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipStrokeColor="@color/gray"
                    app:chipStrokeWidth="1dp"
                    android:enabled="false"
                    app:textEndPadding="12dp"
                    app:textStartPadding="12dp"
                    android:textColor="@color/chip_text_selector"
                    style="@style/Widget.MaterialComponents.Chip.Filter"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUnisex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="남녀공용"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipStrokeColor="@color/gray"
                    app:chipStrokeWidth="1dp"
                    android:enabled="false"
                    app:textEndPadding="12dp"
                    app:textStartPadding="12dp"
                    android:textColor="@color/chip_text_selector"
                    style="@style/Widget.MaterialComponents.Chip.Filter"/>
            </com.google.android.material.chip.ChipGroup>

            <!-- 기타 정보 섹션 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기타 정보"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/memoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/memo_background"
                android:padding="12dp"
                android:textSize="16sp"
                android:minHeight="48dp"/>

            <LinearLayout
                android:id="@+id/memberOnlyBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_marginTop="25dp">

                <Button
                    android:id="@+id/rewriteInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:text="정보수정"
                    android:textSize="20sp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/rounded_button"
                    android:maxLines="1"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/writeReview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="리뷰 작성하기"
                    android:textSize="20sp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/rounded_button"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:layout_marginBottom="10dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_centerInParent="true"
                android:background="#313030"/>

            <!-- 리뷰 섹션 -->
            <LinearLayout
                android:id="@+id/reviewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:layout_marginEnd="8dp"
                    android:text="리뷰"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/reviewRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>