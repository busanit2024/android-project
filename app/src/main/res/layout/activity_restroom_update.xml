<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="화장실 정보 수정하기"
                android:textStyle="bold"
                android:textSize="25sp"
                android:textAlignment="center"
                android:layout_marginVertical="10dp"
                android:layout_gravity="center"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 지도 추가 -->
            <com.google.android.gms.maps.MapView
                android:id="@+id/mapViewUpdate"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp" />

            <!-- 건물명/상세주소 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="건물명 / 상세주소"
                android:textSize="25sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editRestroomName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="건물명"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="상세주소"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 개방시간 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="개방시간"
                android:textSize="18sp"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editOpenTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="개방시간"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 편의시설 정보 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="편의시설"
                android:textSize="18sp"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFullTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24시간 개방"
                    android:checkable="true"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDiaper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기저귀 교환대"
                    android:checkable="true"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAccessible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="장애인 화장실"
                    android:checkable="true"/>
            </com.google.android.material.chip.ChipGroup>

            <!-- 남녀공용 여부 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="남녀공용 여부"
                android:textSize="18sp"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUnisex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="남녀공용"
                android:checkable="true"
                android:layout_marginTop="8dp"/>

            <!-- 기타 메모 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기타"
                android:textSize="18sp"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editMemo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="기타 정보"
                    android:minLines="3"
                    android:gravity="top"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 버튼 -->
            <LinearLayout
                android:id="@+id/memberonlyBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/rewriteInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:text="수정하기"
                    android:textSize="20sp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/rounded_button"
                    android:maxLines="1"
                    android:singleLine="true"/>

                <Button
                    android:id="@+id/deleteRequestButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="삭제요청"
                    android:textSize="20sp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/rounded_button"
                    android:maxLines="1"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>