<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="viewModel"
            type="com.busanit.searchrestroom.reviewReg.FilterViewModel" />
    </data>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="리뷰 작성하기"
                android:textStyle="bold"
                android:textSize="23sp"
                android:textAlignment="center"
                android:layout_marginVertical="10dp"
                android:layout_gravity="center"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <!-- 리뷰 레이아웃 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/UdpateRestroomName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="건물명"
                android:textSize="21sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/UpdateRestroomLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="상세주소"
                android:textSize="20sp"
                android:textColor="#5F5E5E"
                android:layout_marginBottom="15dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_centerInParent="true"
            android:background="#8A8585"/>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- 필터 옵션 작성-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/review_toilet_paper"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="3dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/filter_question1_toilet_paper"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="30dp"
                        android:overScrollMode="never"
                        app:layoutManager="com.google.android.flexbox.FlexboxLayoutManager"
                        tools:itemCount="2"
                        tools:listitem="@layout/review_filter_option" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/review_how_many"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="3dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/filter_question2_how_many"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="30dp"
                        android:overScrollMode="never"
                        app:layoutManager="com.google.android.flexbox.FlexboxLayoutManager"
                        tools:itemCount="4"
                        tools:listitem="@layout/review_filter_option" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/review_cleanliness"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="3dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/filter_question3_cleanliness"
                        android:layout_width="356dp"
                        android:layout_height="60dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="30dp"
                        android:overScrollMode="never"
                        app:layoutManager="com.google.android.flexbox.FlexboxLayoutManager"
                        tools:itemCount="3"
                        tools:listitem="@layout/review_filter_option" />
                </LinearLayout>

                <!-- 후기 작성 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="후기 작성"
                        android:layout_marginBottom="3dp"
                    />
                    <EditText
                        android:id="@+id/reviewContent"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:hint="@string/review_txt"
                        android:background="@drawable/review_border"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/writeReviewButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/member_button"
                        android:text="작성완료" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</LinearLayout>
</layout>