<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white">
            <ImageView
                android:id="@+id/back_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="15dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Back Button" />
            <TextView
                android:id="@+id/toolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="리뷰 작성하기"
                android:textStyle="bold"
                android:textSize="23sp"
                android:textAlignment="center"
                android:layout_marginVertical="10dp"
                android:layout_gravity="center"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <!-- 리뷰 레이아웃 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/UdpateRestroomName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="건물명"
                android:textSize="21sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/UpdateRestroomLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="상세주소"
                android:textSize="20sp"
                android:textColor="#5F5E5E"
                android:layout_marginBottom="15dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_centerInParent="true"
            android:background="#8A8585"/>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- 필터 옵션 작성-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/review_toilet_paper"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="3dp" />

                    <RadioButton
                        android:id="@+id/toilet_paper_Y"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:button="@null"
                        android:text="휴지 있음"
                        android:gravity="center"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="30dp"
                        android:background="@drawable/selector_radio_button"
                        android:textColor="@drawable/selector_radio_text"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/review_how_many"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="3dp" />

                    <RadioGroup
                        android:id="@+id/how_many"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="30dp"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/how_many_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:button="@null"
                            android:text="1칸"
                            android:gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/selector_radio_button"
                            android:textColor="@drawable/selector_radio_text"
                            android:layout_marginRight="3dp"/>
                        <RadioButton
                            android:id="@+id/how_many_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:button="@null"
                            android:text="2칸"
                            android:gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/selector_radio_button"
                            android:textColor="@drawable/selector_radio_text"
                            android:layout_marginRight="3dp" />
                        <RadioButton
                            android:id="@+id/how_many_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:button="@null"
                            android:text="3칸"
                            android:gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/selector_radio_button"
                            android:textColor="@drawable/selector_radio_text"
                            android:layout_marginRight="3dp"/>
                        <RadioButton
                            android:id="@+id/how_many_4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:button="@null"
                            android:text="4칸 이상"
                            android:gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/selector_radio_button"
                            android:textColor="@drawable/selector_radio_text"
                           />
                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/review_cleanliness"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="3dp"
                        android:layout_marginRight="3dp"/>

                    <RadioGroup
                        android:id="@+id/cleanliness"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="30dp"
                        android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/cleanliness_clean"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:button="@null"
                        android:text="깨끗함"
                        android:gravity="center"
                        android:layout_weight="1"
                        android:background="@drawable/selector_radio_button"
                        android:textColor="@drawable/selector_radio_text"
                        android:layout_marginRight="3dp"/>
                    <RadioButton
                        android:id="@+id/cleanliness_soso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:button="@null"
                        android:text="무난함"
                        android:gravity="center"
                        android:layout_weight="1"
                        android:background="@drawable/selector_radio_button"
                        android:textColor="@drawable/selector_radio_text"
                        android:layout_marginRight="3dp"/>
                    <RadioButton
                        android:id="@+id/cleanliness_dirty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:button="@null"
                        android:text="더러움"
                        android:gravity="center"
                        android:layout_weight="1"
                        android:background="@drawable/selector_radio_button"
                        android:textColor="@drawable/selector_radio_text"/>
                    </RadioGroup>
                </LinearLayout>

                <!-- 후기 작성 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="후기 작성"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"
                    />
                    <EditText
                        android:id="@+id/reviewContent"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:hint="@string/review_txt"
                        android:background="@drawable/review_border"/>
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/writeReviewButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/member_button"
                        android:text="작성완료" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</LinearLayout>
</layout>