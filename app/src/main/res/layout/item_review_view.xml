<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/review_item_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <!-- 리뷰 작성자 정보 및 삭제, 수정 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="4dp">
        <TextView
            android:id="@+id/reviewNickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:text="사용자명"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/reviewRegDate"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="작성일자"
            android:textSize="15sp" />
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" >
            <TextView
                android:id="@+id/btnDeleteReview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="삭제"
                android:textSize="15sp" />
            <View
                android:id="@+id/divisionLine"
                android:layout_width="1dp"
                android:layout_height="12dp"
                android:background="@color/black"
                android:layout_marginHorizontal="8dp" />
            <TextView
                android:id="@+id/btnEditReview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="수정"
                android:textSize="15sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 리뷰 내용과 필터 옵션 -->
    <LinearLayout
        android:id="@+id/reviewBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp">
        <LinearLayout
            android:id="@+id/filterOptionsContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="5dp"
            android:paddingLeft="0dp"/>
        <!-- 리뷰 내용 -->
        <TextView
            android:id="@+id/reviewText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="댓글 내용"
            android:textStyle="bold"
            android:textSize="13sp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8E8E8"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"/>
</LinearLayout>
